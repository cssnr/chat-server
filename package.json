{
  "name": "chat-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "npx tsc",
    "dev": "nodemon --exec tsx src/index.ts",
    "lint": "npx eslint src",
    "prepare": "npm run build",
    "prettier": "npm run prettier:write",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "start": "node dist/index.js",
    "test": "npx tsc --noEmit -p tsconfig.test.json && tsx --test test/*.test.ts",
    "tsc": "npx tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.49",
    "@ai-sdk/openai": "^4.0.45",
    "@ai-sdk/openai-compatible": "^3.0.34",
    "ai": "^7.0.73",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.8.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
